# Copy to .env.local and adjust — .env*.local is gitignored.

# Comma-separated LAN origins allowed to access `pnpm dev`, so teammates can
# preview the docs at http://<your-ip>:3000 (find yours with `ip addr` /
# `ipconfig`). Dev-only; the static export is unaffected.
ALLOWED_DEV_ORIGINS=192.168.1.100
